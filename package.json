{
  "name": "hatko",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Semantic search and grounded answers over an internal document corpus",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @hatko/web",
    "test": "node --test \"packages/**/*.test.ts\" \"apps/api/src/**/*.test.ts\" \"apps/mcp/src/**/*.test.ts\" \"apps/web/lib/**/*.test.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "npm run migrate --workspace @hatko/core",
    "db:reset": "npm run reset --workspace @hatko/core",
    "ingest": "npm run ingest --workspace @hatko/core --",
    "eval": "npm run eval --workspace @hatko/core --",
    "ask": "npm run ask --workspace @hatko/core --",
    "seed": "npm run seed --workspace @hatko/core",
    "setup": "npm run db:migrate && npm run seed && npm run ingest",
    "dev:api": "npm run dev --workspace @hatko/api",
    "start:api": "npm run start --workspace @hatko/api",
    "dev:mcp": "npm run dev --workspace @hatko/mcp",
    "start:mcp": "npm run start --workspace @hatko/mcp",
    "dev:web": "npm run dev --workspace @hatko/web",
    "build:web": "npm run build --workspace @hatko/web",
    "start:web": "npm run start --workspace @hatko/web"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
