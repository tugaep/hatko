# Copy to .env and fill in. Only OPENAI_API_KEY has no working default.
# cp .env.example .env

# --- Model provider -----------------------------------------------------------
# Used for embeddings (ingestion + queries) and for answer generation.
#
# Two ways to supply this, and both work:
#   1. here, which is what the ingestion CLI needs before any user account exists
#   2. the admin settings page in the web UI, which stores it encrypted in the
#      database so an operator can rotate it without shell access
#
# The database value wins when both are set, and the settings page names the
# active source. Leave this blank if you would rather set it from the UI — every
# read path, migration and the dashboard all work without a key.
OPENAI_API_KEY=

# Where the model API lives. Leave this alone to use OpenAI.
#
# The system calls exactly two endpoints, /embeddings and /chat/completions, and Ollama,
# llama.cpp, LM Studio and vLLM all serve them in OpenAI's own shape — so pointing this
# at a local server runs everything with no external provider and no API key:
#
#   OPENAI_BASE_URL=http://localhost:11434/v1
#
# Local support is deliberately basic: one validated configuration, measured equal to
# OpenAI on the eval set and slower. Two smaller models were measured and rejected for
# failing to abstain. Read docs/self-hosted.md before switching — the embedding model
# and the index have to change together.
OPENAI_BASE_URL=https://api.openai.com/v1

# text-embedding-3-small is 1536 dimensions. This value is substituted into the vector
# column width in packages/core/src/db/migrations/001_init.sql when the database is
# created, so it is the schema, not a hint about it.
#
# Changing it means rebuilding: vectors from two embedding models cannot be compared, a
# vec0 column width cannot be altered, and the migration refuses to open a database whose
# stored width disagrees rather than letting search quietly return nothing.
#
#   npm run db:reset && npm run ingest
#
# The self-hosted pair is nomic-embed-text at 768.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Answer generation and the retrieval reranking pass. Both, and OPENAI_BASE_URL above,
# can also be set by an admin on the dashboard, which stores them in the database and
# overrides these — the same precedence the API key uses. The panel names the active
# source. The embedding model is deliberately not settable there, because changing it
# needs an index rebuild.
ANSWER_MODEL=gpt-4o-mini
RERANK_MODEL=gpt-4o-mini

# --- Storage ------------------------------------------------------------------
# SQLite file. Relative paths resolve from the repository root.
DATABASE_PATH=./data/hatko.db

# Directory the ingestion pipeline reads. Point this at the real corpus to switch.
CORPUS_PATH=./sample_dataset/corpus

# --- Services -----------------------------------------------------------------
API_PORT=4000
API_URL=http://localhost:4000
# The web app's own port is Next's (`next dev -p`), not a variable this project reads.
WEB_URL=http://localhost:3000

# MCP server, a separate process from the API. Its endpoint is /mcp on this port.
# The server only accepts requests whose Host header names this machine (localhost,
# 127.0.0.1 or [::1], with or without the port), so changing this changes what it
# will answer to. See docs/mcp.md.
MCP_PORT=4100

# Public URL of the MCP endpoint, advertised to OAuth clients as the `resource` they
# are being granted access to. It must be the address clients actually dial: behind a
# reverse proxy that is the public origin, not localhost. Getting this wrong does not
# break the bearer path, only the OIDC one — clients reject a token whose audience
# does not match where they are sending it.
MCP_URL=http://localhost:4100/mcp

# Exposed to the browser. Must match API_URL.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Auth ---------------------------------------------------------------------
# Root application secret, minimum 32 characters. Generate with:
#   openssl rand -base64 32
#
# Better Auth signs sessions with it, and an independent key is HKDF-derived from
# it to encrypt secrets stored in the settings table. Changing it after saving an
# API key from the UI makes that key undecryptable — the app says so explicitly
# and asks for it to be re-entered, rather than silently reporting no key.
BETTER_AUTH_SECRET=replace-me-with-a-random-32-byte-secret

# There is deliberately no BETTER_AUTH_URL here. Better Auth would read one, but its
# baseURL is passed explicitly from API_URL in packages/core/src/auth/index.ts, so a
# second variable naming the same address could only ever disagree with the first.

# --- Rate limiting ------------------------------------------------------------
# How many requests to the paid retrieval paths one account may make per window.
# Covers POST /api/search, POST /api/answer and the MCP search_corpus tool, which all
# draw from the same per-account allowance — a client's tool calls and a person's web
# searches spend one budget, so alternating between them buys nothing.
#
# The limit exists for provider spend, not abuse: an /answer costs three model calls, so
# 30 a minute caps one account near 90 rather than at nothing. Generous for a person and
# still a ceiling on a client stuck in a retry loop.
#
# Configurable rather than hard-coded because a limit an operator cannot adjust is a
# limit an operator switches off. Both servers print the active value at startup.
# Set RATE_LIMIT_MAX=0 to disable it entirely; the startup line then says so.
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_SECONDS=60

# Seeded demo accounts (see README). Passwords are only used by the seed script.
SEED_ADMIN_EMAIL=efe@tugrap.dev
SEED_ADMIN_PASSWORD=PlayableFactory7766
SEED_USER_EMAIL=user@tugrap.dev
SEED_USER_PASSWORD=PlayableFactory6677

# --- Production -----------------------------------------------------------------
# Everything below is only needed for a deployment. See docs/deployment.md.
#
# Set NODE_ENV=production and session cookies become Secure, which means the app
# stops working over plain HTTP — that is the intended behaviour, not a fault.
# NODE_ENV=production
#
# The recommended topology is one origin behind a reverse proxy, which removes CORS
# and cross-domain cookies from the picture entirely:
#
#   API_URL=https://hatko.tugrap.dev
#   WEB_URL=https://hatko.tugrap.dev
#   NEXT_PUBLIC_API_URL=https://hatko.tugrap.dev
#   MCP_URL=https://hatko.tugrap.dev/mcp
#
# Extra Host values the MCP server will answer to, comma-separated. Behind a proxy
# the Host is the public hostname, and the DNS-rebinding guard rejects anything it
# does not recognise — so without this a deployed MCP server returns 403 to
# everything. Loopback is always accepted and does not need listing.
#
#   MCP_ALLOWED_HOSTS=hatko.tugrap.dev
