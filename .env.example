# Copy to .env and fill in. Only OPENAI_API_KEY has no working default.
# cp .env.example .env

# --- Model provider -----------------------------------------------------------
# Used for embeddings (ingestion + queries) and for answer generation.
#
# Two ways to supply this, and both work:
#   1. here, which is what the ingestion CLI needs before any user account exists
#   2. the admin settings page in the web UI, which stores it encrypted in the
#      database so an operator can rotate it without shell access
#
# The database value wins when both are set, and the settings page names the
# active source. Leave this blank if you would rather set it from the UI — every
# read path, migration and the dashboard all work without a key.
OPENAI_API_KEY=

# text-embedding-3-small is 1536 dimensions and matches the vector column width
# declared in packages/core/src/db/migrations/001_init.sql. Changing the model to one
# with different dimensions requires a new migration and a full re-ingest.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Answer generation and the retrieval reranking pass.
ANSWER_MODEL=gpt-4o-mini
RERANK_MODEL=gpt-4o-mini

# --- Storage ------------------------------------------------------------------
# SQLite file. Relative paths resolve from the repository root.
DATABASE_PATH=./data/hatko.db

# Directory the ingestion pipeline reads. Point this at the real corpus to switch.
CORPUS_PATH=./sample_dataset/corpus

# --- Services -----------------------------------------------------------------
API_PORT=4000
API_URL=http://localhost:4000
WEB_PORT=3000
WEB_URL=http://localhost:3000

# MCP server, a separate process from the API. Its endpoint is /mcp on this port.
# The server only accepts requests whose Host header names this machine (localhost,
# 127.0.0.1 or [::1], with or without the port), so changing this changes what it
# will answer to. See docs/mcp.md.
MCP_PORT=4100

# Exposed to the browser. Must match API_URL.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Auth ---------------------------------------------------------------------
# Root application secret, minimum 32 characters. Generate with:
#   openssl rand -base64 32
#
# Better Auth signs sessions with it, and an independent key is HKDF-derived from
# it to encrypt secrets stored in the settings table. Changing it after saving an
# API key from the UI makes that key undecryptable — the app says so explicitly
# and asks for it to be re-entered, rather than silently reporting no key.
BETTER_AUTH_SECRET=replace-me-with-a-random-32-byte-secret
BETTER_AUTH_URL=http://localhost:4000

# Seeded demo accounts (see README). Passwords are only used by the seed script.
SEED_ADMIN_EMAIL=admin@hatko.local
SEED_ADMIN_PASSWORD=hatko-admin-demo
SEED_USER_EMAIL=user@hatko.local
SEED_USER_PASSWORD=hatko-user-demo
